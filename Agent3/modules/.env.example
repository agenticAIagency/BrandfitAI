# Agent 3 Environment Variables

# LLM Configuration
# Choose ONE: Gemini API or Local Ollama

# Option 1: Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-latest

# Option 2: Local Ollama
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Data Paths
DATA_ROOT=./data/creators
STORAGE_DIR=./data/personas
INDEX_DIR=./data/indices

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/agent3.log

# Performance
MAX_WORKERS=10
BATCH_SIZE=50