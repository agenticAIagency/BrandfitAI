BRANDFIT_ENV=development
BRANDFIT_DATABASE_URL=postgresql+asyncpg://brandfit:brandfit@postgres:5432/brandfit
BRANDFIT_DATABASE_URL_SYNC=postgresql+psycopg://brandfit:brandfit@postgres:5432/brandfit
BRANDFIT_REDIS_URL=redis://redis:6379/0
BRANDFIT_MINIO_ENDPOINT=minio:9000
BRANDFIT_MINIO_ACCESS_KEY=brandfit
BRANDFIT_MINIO_SECRET_KEY=change-me
BRANDFIT_MINIO_SECURE=false
BRANDFIT_MINIO_BUCKET=brandfit-evidence
BRANDFIT_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# Ordered provider/model pairs. Configure only credentials you own.
BRANDFIT_PROVIDER_CHAIN=fake:fixture-v1
# JSON mapping to [input USD per million tokens, output USD per million tokens].
# Exact provider:model entries override provider defaults.
BRANDFIT_PROVIDER_PRICING_PER_MILLION={"fake":[0,0],"ollama":[0,0]}
BRANDFIT_OPENAI_API_KEY=
BRANDFIT_OPENAI_BASE_URL=https://api.openai.com/v1
BRANDFIT_GEMINI_API_KEY=
BRANDFIT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
BRANDFIT_GROQ_API_KEY=
BRANDFIT_GROQ_BASE_URL=https://api.groq.com/openai/v1
BRANDFIT_OLLAMA_BASE_URL=http://ollama:11434/v1

BRANDFIT_EMBEDDING_MODEL=BAAI/bge-m3
BRANDFIT_TRANSCRIPTION_MODEL=small
BRANDFIT_ENABLE_OCR=true
BRANDFIT_ENABLE_TRANSCRIPTION=true
BRANDFIT_MAX_REACT_TOOL_CALLS=6
BRANDFIT_ANALYSIS_CONFIDENCE_THRESHOLD=0.70
BRANDFIT_PERSONA_REFRESH_DAY=sunday
BRANDFIT_LOG_LEVEL=INFO
